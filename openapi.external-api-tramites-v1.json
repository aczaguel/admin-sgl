  },
  "components": {
    "securitySchemes": {
      "ApiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Llave de API enviada por header."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key",
        "description": "Alternativa equivalente a X-API-Key."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Clave única por intento de alta.",
        "schema": {
          "type": "string"
        }
      },
      "SourceSystemHeader": {
        "name": "X-Source-System",
        "in": "header",
        "required": false,
        "description": "Sistema origen. Si no viaja, se usa externalApi.defaultSourceSystem.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Credencial faltante o inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseWithStatus"
            },
            "examples": {
              "missingCredential": {
                "value": {
                  "success": false,
                  "status": "error",
                  "message": "Falta credencial de API."
                }
              },
              "invalidCredential": {
                "value": {
                  "success": false,
                  "status": "error",
                  "message": "Credencial de API inválida."
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "TramiteCreateJsonRequest": {
        "type": "object",
        "required": [
          "external_reference",
          "contrato",
          "serie",
          "tra_tipos_id",
          "entidad_id",
          "ent_municipio_id",
          "cli_directo_id",
          "cli_directo_ejecutivo_id"
        ],
        "properties": {
          "external_reference": {
            "type": "string",
            "description": "Referencia externa única por sistema origen."
          },
          "folio": {
            "type": "string",
            "description": "Opcional. Si no se envía, el sistema genera uno."
          },
          "contrato": {
            "type": "string"
          },
          "unidad": {
            "type": "string"
          },
          "serie": {
            "type": "string"
          },
          "placas": {
            "type": "string"
          },
          "tra_tipos_id": {
            "type": "integer",
            "minimum": 1
          },
          "entidad_id": {
            "type": "integer",
            "minimum": 1
          },
          "ent_municipio_id": {
            "type": "integer",
            "minimum": 1
          },
          "cli_directo_id": {
            "type": "integer",
            "minimum": 1
          },
          "cli_directo_ejecutivo_id": {
            "type": "integer",
            "minimum": 1
          },
          "empresa_gestora_id": {
            "type": "integer",
            "nullable": true
          },
          "gestor_id": {
            "type": "integer",
            "nullable": true
          },
          "observaciones": {
            "type": "string"
          },
          "statuses": {
            "$ref": "#/components/schemas/TramiteStatusOverrides"
          },
          "tra_status_id": {
            "type": "integer",
            "nullable": true,
            "deprecated": true,
            "description": "Alias plano tolerado por compatibilidad. Se recomienda usar statuses.tra_status_id."
          },
          "cobro_status_id": {
            "type": "integer",
            "nullable": true,
            "deprecated": true,
            "description": "Alias plano tolerado por compatibilidad. Se recomienda usar statuses.cobro_status_id."
          },
          "reembolso_status_id": {
            "type": "integer",
            "nullable": true,
            "deprecated": true,
            "description": "Alias plano tolerado por compatibilidad. Se recomienda usar statuses.reembolso_status_id."
          },
          "pago_gestor_st_id": {
            "type": "integer",
            "nullable": true,
            "deprecated": true,
            "description": "Alias plano tolerado por compatibilidad. Se recomienda usar statuses.pago_gestor_st_id."
          },
          "documentos": {
            "type": "array",
            "description": "Documentos inline en base64.",
            "items": {
              "$ref": "#/components/schemas/InlineDocumento"
            }
          }
        }
      },
      "TramiteCreateMultipartRequest": {
        "type": "object",
        "required": [
          "external_reference",
          "contrato",
          "serie",
          "tra_tipos_id",
          "entidad_id",
          "ent_municipio_id",
          "cli_directo_id",
          "cli_directo_ejecutivo_id"
        ],
        "properties": {
          "external_reference": {
            "type": "string"
          },
          "folio": {
            "type": "string"
