{
  "openapi": "3.0.3",
  "info": {
    "title": "API Externa de Tramites",
    "version": "1.0.0",
    "description": "Primera superficie versionada para integracion externa de tramites.\n\nEndpoints implementados actualmente:\n- POST /api/v1/tramites\n- GET /api/v1/tramites/{id}\n- GET /api/v1/tramites/referencia/{external_reference}\n\nLa autenticacion acepta cualquiera de estas alternativas:\n- X-API-Key\n- Authorization: Bearer <token>\n\nNotas de contrato vigentes:\n- Idempotency-Key es obligatorio para crear.\n- external_reference es obligatoria y unica por source_system.\n- Se soporta application/json y multipart/form-data.\n- El payload JSON prefiere statuses anidado; los campos planos equivalentes siguen siendo tolerados por compatibilidad.\n"
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "Ejemplo local"
    }
  ],
  "tags": [
    {
      "name": "Tramites",
      "description": "Alta y consulta de tramites externos"
    }
  ],
  "paths": {
    "/api/v1/tramites": {
      "post": {
        "tags": [
          "Tramites"
        ],
        "summary": "Crear tramite externo",
        "description": "Crea un tramite desde un sistema externo.\n\nComportamiento de idempotencia:\n- Si se reenvia la misma solicitud con el mismo Idempotency-Key y el mismo payload, devuelve la misma respuesta y marca idempotent_replay=true.\n- Si se reutiliza el mismo Idempotency-Key con un payload distinto, devuelve 409.\n",
        "operationId": "createExternalTramite",
        "security": [
          {
            "ApiKeyHeader": [

            ]
          },
          {
            "BearerAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/SourceSystemHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TramiteCreateJsonRequest"
              },
              "examples": {
                "altaJson": {
                  "summary": "Alta con documento inline",
                  "value": {
                    "external_reference": "ERP-TRX-000145",
                    "contrato": "CTR-001",
                    "unidad": "Unidad 45",
                    "serie": "SERIE123456",
                    "placas": "ABC123A",
                    "tra_tipos_id": 7,
                    "entidad_id": 14,
                    "ent_municipio_id": 266,
                    "cli_directo_id": 22,
                    "cli_directo_ejecutivo_id": 18,
                    "empresa_gestora_id": 3,
                    "gestor_id": 9,
                    "observaciones": "Alta desde sistema externo",
                    "statuses": {
                      "tra_status_id": 22,
                      "cobro_status_id": 1,
                      "reembolso_status_id": 1,
                      "pago_gestor_st_id": 2
                    },
                    "documentos": [
                      {
                        "nombre": "identificacion.pdf",
                        "mime_type": "application/pdf",
                        "contenido_base64": "JVBERi0xLjQK..."
                      }
                    ]
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TramiteCreateMultipartRequest"
              },
              "encoding": {
                "documentos": {
                  "style": "form",
                  "explode": true
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trámite creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TramiteCreateResponse"
                },
                "examples": {
                  "creado": {
                    "value": {
                      "success": true,
                      "message": "Trámite creado exitosamente.",
                      "tramite_id": 1234,
                      "folio": "TR-2026-001234",
                      "external_reference": "ERP-TRX-000145",
                      "source_system": "erp_principal",
                      "documentos_registrados": 2,
                      "status_snapshot": {
                        "id": 1234,
                        "folio": "TR-2026-001234",
                        "contrato": "CTR-001",
                        "tra_status_id": 22,
                        "tra_status": "DCTOS COMPLETOS",
                        "cobro_status_id": 22,
                        "cobro_status": "En Proceso",
                        "reembolso_status_id": null,
                        "reembolso_status": null,
                        "pago_gestor_st_id": null,
                        "pago_status": null,
                        "cli_directo_id": 22,
                        "empresa_solicitante": "Cliente Demo",
                        "cli_directo_ejecutivo_id": 18,
                        "ejecutivo": "Ejecutivo Demo",
                        "created_at": "2026-05-14 10:30:00",
                        "updated_at": "2026-05-14 10:30:00",
                        "documentos_registrados": 2,
                        "external_reference": "ERP-TRX-000145",
                        "source_system": "erp_principal"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error de solicitud o idempotencia faltante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingIdempotency": {
                    "value": {
                      "success": false,
                      "message": "El header Idempotency-Key es obligatorio."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Conflicto por idempotencia, referencia externa o duplicado de negocio",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/IdempotencyConflictResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ExternalReferenceConflictResponse"
                    },
                    {
                      "$ref": "#/components/schemas/DuplicateBusinessConflictResponse"
                    }
                  ]
                },
                "examples": {
                  "reusedIdempotencyKey": {
                    "value": {
                      "success": false,
                      "message": "El Idempotency-Key ya fue utilizado con un payload distinto."
                    }
                  },
                  "duplicateExternalReference": {
                    "value": {
                      "success": false,
                      "message": "La referencia externa ya existe para este sistema origen.",
                      "existing_tramite_id": 1234,
                      "external_reference": "ERP-TRX-000145",
                      "source_system": "erp_principal",
                      "data": {
                        "id": 1234,
                        "folio": "TR-2026-001234",
                        "contrato": "CTR-001",
                        "tra_status_id": 22,
                        "tra_status": "DCTOS COMPLETOS",
                        "cobro_status_id": 22,
                        "cobro_status": "En Proceso",
                        "reembolso_status_id": null,
                        "reembolso_status": null,
                        "pago_gestor_st_id": null,
                        "pago_status": null,
                        "cli_directo_id": 22,
                        "empresa_solicitante": "Cliente Demo",
                        "cli_directo_ejecutivo_id": 18,
                        "ejecutivo": "Ejecutivo Demo",
                        "created_at": "2026-05-14 10:30:00",
                        "updated_at": "2026-05-14 10:30:00",
                        "documentos_registrados": 2,
                        "external_reference": "ERP-TRX-000145",
                        "source_system": "erp_principal"
                      }
                    }
                  },
                  "duplicateBusiness": {
                    "value": {
                      "success": false,
                      "duplicate": true,
                      "confirmable": true,
                      "message": "El trámite ya fue registrado previamente.",
                      "existing_tramite_id": 777,
                      "duplicate_details": {
                        "id_existente": 777,
                        "folio_existente": "TR-2026-000777",
                        "contrato_existente": "CTR-EXISTENTE",
                        "serie_existente": "SER123",
                        "tipo_tramite_existente": "TENENCIA",
                        "nombre_usuario_existente": "Usuario Previo Test",
                        "created_at_existente": "13/05/2026 09:55",
                        "created_at_existente_raw": "2026-05-13 09:55:00"
                      },
                      "existing_data": {
                        "id": 777,
                        "folio": "TR-2026-000777",
                        "contrato": "CTR-EXISTENTE",
                        "serie": "SER123",
                        "tipo_tramite": "TENENCIA",
                        "created_at": "2026-05-13 09:55:00",
                        "created_at_formatted": "13/05/2026 09:55",
                        "requested_by_user_id": 44,
                        "requested_by_name": "Usuario Previo Test"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validacion fallida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "examples": {
                  "validationError": {
                    "value": {
                      "success": false,
                      "message": "Payload inválido.",
                      "errors": {
                        "contrato": "El contrato es obligatorio.",
                        "cli_directo_ejecutivo_id": "El ejecutivo es obligatorio."
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible o infraestructura de integración incompleta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseWithStatus"
                },
                "examples": {
                  "apiDisabled": {
                    "value": {
                      "success": false,
                      "status": "error",
                      "message": "La API externa está deshabilitada."
                    }
                  },
                  "missingTables": {
                    "value": {
                      "success": false,
                      "message": "Falta configurar las tablas de integración externa. Ejecuta create_external_api_integration_tables.sql."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tramites/{id}": {
      "get": {
        "tags": [
          "Tramites"
        ],
        "summary": "Consultar trámite por id",
        "operationId": "getExternalTramiteById",
        "security": [
          {
            "ApiKeyHeader": [

            ]
          },
          {
            "BearerAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID interno del trámite",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot del trámite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusSnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "ID inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidId": {
                    "value": {
                      "success": false,
                      "message": "ID de trámite inválido."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Trámite no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "value": {
                      "success": false,
                      "message": "Trámite no encontrado."
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "API deshabilitada o sin llaves configuradas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseWithStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tramites/referencia/{external_reference}": {
      "get": {
        "tags": [
          "Tramites"
        ],
        "summary": "Consultar trámite por referencia externa",
        "operationId": "getExternalTramiteByReference",
        "security": [
          {
            "ApiKeyHeader": [

            ]
          },
          {
            "BearerAuth": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "external_reference",
            "in": "path",
            "required": true,
            "description": "Referencia externa única por sistema origen",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/SourceSystemHeader"
          },
          {
            "name": "source_system",
            "in": "query",
            "required": false,
            "description": "Sistema origen alternativo al header X-Source-System",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot del trámite ligado a la referencia externa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusSnapshotResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No existe un trámite ligado a esa referencia externa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "value": {
                      "success": false,
                      "message": "No existe un trámite ligado a esa referencia externa."
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "API deshabilitada, sin llaves o tabla de referencias no configurada",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponseWithStatus"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                },
                "examples": {
                  "apiDisabled": {
                    "value": {
                      "success": false,
                      "status": "error",
                      "message": "La API externa está deshabilitada."
                    }
                  },
                  "missingReferenceTable": {
                    "value": {
                      "success": false,
                      "message": "La tabla de referencias externas no está configurada."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "x-webhooks": {
    "tramite.created": {
      "post": {
        "tags": [
          "Tramites"
        ],
        "summary": "Evento emitido al crear un trámite externo",
        "description": "Webhook saliente enviado como POST JSON a cada URL configurada en externalApi.webhookUrls.\n\nEn el comportamiento actual:\n- Se envía con Accept: application/json\n- Se envía con Content-Type: application/json\n- Se envía con User-Agent: admin-sgl-external-api/1.0\n- Se considera entrega exitosa cualquier respuesta HTTP 2xx\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TramiteCreatedWebhookPayload"
              },
              "examples": {
                "created": {
                  "value": {
                    "event": "tramite.created",
                    "source_system": "erp_principal",
                    "external_reference": "ERP-TRX-000145",
                    "tramite": {
                      "id": 1234,
                      "folio": "TR-2026-001234",
                      "contrato": "CTR-001",
                      "tra_status_id": 22,
                      "tra_status": "DCTOS COMPLETOS",
                      "cobro_status_id": 22,
                      "cobro_status": "En Proceso",
                      "reembolso_status_id": null,
                      "reembolso_status": null,
                      "pago_gestor_st_id": null,
                      "pago_status": null,
                      "cli_directo_id": 22,
                      "empresa_solicitante": "Cliente Demo",
                      "cli_directo_ejecutivo_id": 18,
                      "ejecutivo": "Ejecutivo Demo",
                      "created_at": "2026-05-14 10:30:00",
                      "updated_at": "2026-05-14 10:30:00",
                      "documentos_registrados": 2,
                      "external_reference": "ERP-TRX-000145",
                      "source_system": "erp_principal"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "El receptor procesó el webhook correctamente."
          },
          "202": {
            "description": "El receptor aceptó el webhook para procesamiento asíncrono."
          },
          "204": {
            "description": "El receptor confirmó el webhook sin body."
          }
        }
      }
    },
    "tramite.status_changed": {
      "post": {
        "tags": [
          "Tramites"
        ],
        "summary": "Evento emitido cuando cambia tra_status_id de un trámite rastreado",
        "description": "Webhook saliente emitido cuando un trámite creado por integración externa cambia de estatus\ny ese cambio pasa por los caminos actualmente integrados con la cola de webhooks.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TramiteStatusChangedWebhookPayload"
