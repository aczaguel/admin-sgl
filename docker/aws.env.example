# Template for local-only AWS credentials (dev IAM user).
# Copy to docker/aws.env and fill from `terraform output`:
#   terraform output dev_access_key_id
#   terraform output -raw dev_secret_access_key
#
# docker/aws.env is gitignored. NEVER commit real keys.
# In production the EC2 uses its IAM Instance Profile and needs NO keys.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
