# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# Remember: S3 bucket names are globally unique across ALL AWS accounts.

region = "us-east-1"
project = "admin-sgl"

# If these are taken, append a unique suffix, e.g. "...-451797130916".
dev_bucket_name  = "bucket-sgl-uploads-dev"
prod_bucket_name = "bucket-sgl-uploads-prod"

dev_iam_user_name = "sgl-uploads-dev-user"
