  "item": [
    {
      "name": "API",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const readVar = (key, placeholder) => {",
              "  const value = pm.variables.get(key);",
              "  if (!value) return '';",
              "  const normalized = String(value).trim();",
              "  if (normalized === '' || normalized === placeholder || normalized.includes('{{')) return '';",
              "  return normalized;",
              "};",
              "const apiKey = readVar('apiKey', 'reemplazar-por-api-key');",
              "const bearerToken = readVar('bearerToken', 'reemplazar-por-bearer-token');",
              "if (!apiKey && !bearerToken) {",
              "  throw new Error('Configura apiKey o bearerToken en el environment activo antes de enviar requests de la API.');",
              "}",
              "if (apiKey) {",
              "  pm.request.headers.upsert({ key: 'X-API-Key', value: apiKey });",
              "  pm.request.headers.remove('Authorization');",
              "} else {",
              "  pm.request.headers.remove('X-API-Key');",
              "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + bearerToken });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Crear tramite externo - JSON",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = String(Date.now());",
                  "pm.collectionVariables.set('timestamp', ts);",
                  "pm.collectionVariables.set('idempotencyKey', 'idem-' + ts);",
                  "pm.collectionVariables.set('externalReference', 'ERP-TRX-' + ts);",
                  "pm.collectionVariables.set('serieDemo', 'SERIE' + ts);",
                  "pm.collectionVariables.set('contratoDemo', 'CTR-' + ts);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 o replay 200/201\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Respuesta success\", function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "});",
                  "if (json.tramite_id) pm.collectionVariables.set(\"tramiteId\", String(json.tramite_id));",
                  "if (json.external_reference) pm.collectionVariables.set(\"externalReference\", String(json.external_reference));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
